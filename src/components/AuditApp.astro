      <div class="content-detail-dimensions">${Object.entries(analysis.dimensions).map(([key, value]) => `<div><span>${escapeHtml(dimensionLabels[key] || key)}</span><i><b class="${scoreTone(value)}" style="width:${value}%"></b></i><strong class="${scoreTone(value)}">${value}</strong></div>`).join('')}</div>
      <div class="content-fact-grid"><div><span>Предложений</span><strong>${analysis.sentenceCount || '—'}</strong></div><div><span>Слов в предложении</span><strong>${analysis.averageSentenceWords || '—'}</strong></div><div><span>Длинных предложений</span><strong>${analysis.longSentencePercent}%</strong></div><div><span>Фактов и чисел</span><strong>${analysis.factsAndNumbers}</strong></div><div><span>Внешних ссылок</span><strong>${analysis.sourceLinks}</strong></div><div><span>Риск повторов</span><strong class="${analysis.repetitionRisk >= 45 ? 'bad' : 'good'}">${analysis.repetitionRisk}</strong></div></div>
      ${analysis.firstParagraph ? `<section class="dialog-section"><h3>Первый абзац</h3><p><span>${escapeHtml(analysis.firstParagraph)}</span></p></section>` : ''}
      <div class="content-detail-columns"><section class="dialog-section"><h3>Сильные стороны</h3>${analysis.strengths.map((item) => `<p class="positive-line"><strong>✓</strong><span>${escapeHtml(item)}</span></p>`).join('') || '<p><span>Явных сильных сигналов пока не найдено.</span></p>'}</section><section class="dialog-section"><h3>Слабые стороны</h3>${analysis.weaknesses.map((item) => `<p class="negative-line"><strong>!</strong><span>${escapeHtml(item)}</span></p>`).join('') || '<p><span>Критичных пробелов модели не найдено.</span></p>'}</section></div>
