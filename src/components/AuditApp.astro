      ${report.keywordSummary.map((item) => `<div class="keyword-line"><strong>${escapeHtml(item.keyword)}</strong><span>${item.totalCount}</span><span>${item.pageCoverage}%</span><span>${item.averageDensity}%</span><span>${item.titleCoverage}%</span><span>${item.h1Coverage}%</span></div>`).join('')}
    </div>` : '<div class="empty-keywords"><strong>Целевые фразы не заданы</strong><p>Запустите новый аудит и укажите до 10 ключей — SiteScan проверит вхождения, плотность, title, description, H1, URL и первые 100 слов.</p></div>';
    $('#top-terms').innerHTML = report.topTerms.map((item, index) => `<div class="term-row"><span>${String(index + 1).padStart(2, '0')}</span><strong>${escapeHtml(item.term)}</strong><i><b style="width:${Math.min(100, item.density * 28)}%"></b></i><small>${item.count} · ${item.density}% · ${item.pages} стр.</small></div>`).join('') || '<p class="empty-state">Недостаточно текста для анализа.</p>';
    $('#content-pages-table').innerHTML = report.pages.map((page, index) => { const analysis = contentFor(page); const passed = analysis.checks.filter((check) => check.passed).length; return `<tr><td><a href="${escapeHtml(page.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(page.url))}</a><small>${escapeHtml(analysis.pageType)} · ${escapeHtml(analysis.searchIntent)}</small></td><td><strong class="table-score ${scoreTone(analysis.score)}">${analysis.score} · ${analysis.grade}</strong></td><td>${analysis.dimensions.intent}</td><td>${analysis.dimensions.depth}</td><td>${analysis.dimensions.experience}</td><td>${analysis.dimensions.expertise}</td><td>${analysis.dimensions.trust}</td><td>${analysis.dimensions.aiReadiness}</td><td><span class="check-ratio ${passed === analysis.checks.length ? 'complete' : ''}">${passed}/${analysis.checks.length || '—'}</span></td><td>${page.wordCount}</td><td><button class="page-detail-button" type="button" data-content-page="${index}">Разбор + промпты</button></td></tr>`; }).join('');
    const duplicateItems = [
      ...report.duplicates.titles.map((item) => ({ label: 'Title', item })),
      ...report.duplicates.descriptions.map((item) => ({ label: 'Description', item })),
      ...report.duplicates.h1.map((item) => ({ label: 'H1', item })),
      ...report.duplicates.content.map((item) => ({ label: 'Контент', item })),
