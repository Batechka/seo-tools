    const page = currentReport.pages[index]; if (!page) return;
    $('#dialog-title').textContent = shortUrl(page.url);
    $('#page-dialog-content').innerHTML = `<div class="dialog-score-grid">${[['SEO',page.score],['Контент',page.contentScore],['Читаемость',page.readabilityScore],['AI-цитирование',page.aiCitationScore]].map(([label,value]) => `<div><span>${label}</span><strong class="${scoreTone(Number(value))}">${value}</strong></div>`).join('')}</div>
      <dl class="page-facts"><div><dt>Индексация</dt><dd>${page.indexable ? 'Разрешена' : 'Не индексируется'} · глубина ${page.depth < 0 ? 'не определена' : page.depth} · ${page.incomingLinks} входящих ссылок</dd></div>${page.redirected ? `<div><dt>Редирект</dt><dd>${escapeHtml(page.originalUrl)} → ${escapeHtml(page.finalUrl)}</dd></div>` : ''}<div><dt>Title</dt><dd>${escapeHtml(page.title || 'Отсутствует')}</dd></div><div><dt>Description</dt><dd>${escapeHtml(page.description || 'Отсутствует')}</dd></div><div><dt>Canonical</dt><dd>${escapeHtml(page.canonical || 'Отсутствует')}</dd></div><div><dt>Robots / HTTP</dt><dd>${escapeHtml(page.robots || 'index, follow')}${page.xRobots ? ` · X-Robots: ${escapeHtml(page.xRobots)}` : ''}${page.snippetControls?.length ? ` · ограничения: ${escapeHtml(page.snippetControls.join(', '))}` : ''}</dd></div><div><dt>HTML / DOM / JS</dt><dd>${Math.round(page.htmlBytes/1024)} КБ · ${page.domNodes} элементов · ${page.scripts} скриптов${page.jsAppShellRisk ? ' · риск app shell' : ''}</dd></div><div><dt>Ссылки</dt><dd>${page.internalLinks} внутренних · ${page.externalLinks} внешних · ${page.brokenLinks} битых</dd></div><div><dt>Изображения</dt><dd>${page.images}, без alt: ${page.imagesMissingAlt}, без размеров: ${page.imagesMissingDimensions}, без fallback: ${page.responsiveImagesMissingFallback || 0}</dd></div><div><dt>Видео</dt><dd>${page.videos || 0} · без poster: ${page.videosMissingPoster || 0} · VideoObject: ${page.videoSchemaFound ? 'да' : 'нет'}</dd></div><div><dt>Hreflang</dt><dd>${page.hreflangCount} вариантов · ошибок: ${page.hreflangErrors || 0}</dd></div><div><dt>Даты</dt><dd>публикация: ${escapeHtml(page.publishedDate || 'не найдена')} · обновление: ${escapeHtml(page.modifiedDate || 'не найдено')}</dd></div><div><dt>Schema.org</dt><dd>${escapeHtml(page.schemaTypes.join(', ') || 'не найдена')}</dd></div></dl>
      ${page.keywordMetrics.length ? `<section class="dialog-section"><h3>Ключевые фразы</h3>${page.keywordMetrics.map((item) => `<p><strong>${escapeHtml(item.keyword)}</strong><span>${item.count} вх. · ${item.density}% · title ${item.inTitle?'да':'нет'} · H1 ${item.inH1?'да':'нет'}</span></p>`).join('')}</section>` : ''}
      <section class="dialog-section"><h3>Проблемы страницы (${page.issues.length})</h3>${page.issues.map((item) => `<p><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.recommendation)}</span></p>`).join('') || '<p>Проблем не найдено.</p>'}</section>`;
    delete ($('#page-dialog') as HTMLDialogElement).dataset.contentPage; ($('#page-dialog') as HTMLDialogElement).showModal();
  }

  function openContentDetails(index: number) {
    if (!currentReport) return; const page = currentReport.pages[index]; if (!page) return; const analysis = contentFor(page);
    const dimensionLabels: Record<string, string> = { intent: 'Соответствие интенту', depth: 'Полнота раскрытия', structure: 'Структура', readability: 'Читабельность', originality: 'Уникальность', experience: 'Реальный опыт', expertise: 'Экспертность', trust: 'Доверие', keywordUse: 'Работа с ключами', aiReadiness: 'AI-цитируемость' };
