      ${analysis.outline.length ? `<section class="dialog-section"><h3>Структура заголовков</h3>${analysis.outline.map((item) => `<p><span>${escapeHtml(item)}</span></p>`).join('')}</section>` : ''}
      ${page.keywordMetrics.length ? `<section class="dialog-section"><h3>Ключевые фразы</h3>${page.keywordMetrics.map((item) => `<p><strong>${escapeHtml(item.keyword)}</strong><span>${item.count} вхождений · ${item.density}% · title ${item.inTitle?'да':'нет'} · description ${item.inDescription?'да':'нет'} · H1 ${item.inH1?'да':'нет'} · начало ${item.inFirst100Words?'да':'нет'}</span></p>`).join('')}</section>` : ''}
      <section class="dialog-section content-checks"><h3>Расширенные проверки (${analysis.checks.filter((check) => check.passed).length}/${analysis.checks.length} пройдено)</h3>${analysis.checks.map((check) => `<div class="content-check ${check.passed ? 'passed' : 'failed'}"><span>${check.passed ? '✓' : '!'}</span><div><strong>${escapeHtml(check.label)}</strong><p>${escapeHtml(check.evidence)}</p>${check.passed ? '' : `<small>${escapeHtml(check.recommendation)}</small>`}</div>${check.passed ? '' : `<button type="button" data-copy-content-check="${escapeHtml(check.id)}">Промпт</button>`}</div>`).join('')}</section>
