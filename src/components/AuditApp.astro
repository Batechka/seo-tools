    localStorage.setItem('sitescan:monitor', String(minutes)); ($('#monitor-interval') as HTMLSelectElement).value = String(minutes); button.textContent = 'Выключить'; status.textContent = `Активен: следующий аудит примерно через ${minutes} мин. Оставьте вкладку открытой.`;
    monitorTimer = window.setInterval(() => { if (currentReport && !activeController) run({ url: currentReport.url, limit: currentReport.crawlLimit, keywords: currentReport.targetKeywords.join(', ') }); }, minutes * 60_000);
  }
  $('#monitor-toggle').addEventListener('click', () => setMonitoring(monitorTimer ? null : Number(($('#monitor-interval') as HTMLSelectElement).value)));
  const savedMonitor = Number(localStorage.getItem('sitescan:monitor')); if ([15,60,360,1440].includes(savedMonitor)) setMonitoring(savedMonitor);
  renderHistory();
</script>

