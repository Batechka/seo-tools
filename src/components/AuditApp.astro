    $('#duplicate-report').innerHTML = duplicateItems.length ? duplicateItems.slice(0, 12).map(({ label, item }) => `<div><span>${label}</span><p><strong>${escapeHtml(item.value)}</strong><small>${item.urls.length} страниц</small></p></div>`).join('') : '<p class="empty-state">Межстраничных дублей не найдено.</p>';
    $('#anchor-report').innerHTML = report.anchorTexts.length ? report.anchorTexts.slice(0, 12).map((item) => `<div><span>${item.count}</span><p><strong>${escapeHtml(item.text)}</strong><small>ведёт на ${item.targets} URL</small></p></div>`).join('') : '<p class="empty-state">Внутренние анкоры не найдены.</p>';
    renderSearchConsole(report.searchConsole || []);
  }

  function renderSearchConsole(rows: SearchConsoleRow[]) {
    if (!rows.length) { $('#gsc-report').innerHTML = '<p class="empty-state">CSV ещё не загружен.</p>'; return; }
    const opportunities = [...rows].sort((a, b) => (b.impressions * (1 - Math.min(1, b.ctr))) - (a.impressions * (1 - Math.min(1, a.ctr)))).slice(0, 30);
    const clicks = rows.reduce((sum, row) => sum + row.clicks, 0); const impressions = rows.reduce((sum, row) => sum + row.impressions, 0);
    $('#gsc-report').innerHTML = `<div class="import-summary"><div><strong>${Math.round(clicks)}</strong><span>кликов</span></div><div><strong>${Math.round(impressions)}</strong><span>показов</span></div><div><strong>${impressions ? (clicks / impressions * 100).toFixed(2) : 0}%</strong><span>CTR</span></div><div><strong>${rows.length}</strong><span>строк</span></div></div><div class="table-wrap borderless"><table><thead><tr><th>Страница / запрос</th><th>Клики</th><th>Показы</th><th>CTR</th><th>Позиция</th><th>Возможность</th></tr></thead><tbody>${opportunities.map((row) => `<tr><td><strong>${escapeHtml(row.key)}</strong></td><td>${row.clicks}</td><td>${row.impressions}</td><td>${(row.ctr * 100).toFixed(2)}%</td><td>${row.position.toFixed(1)}</td><td>${row.impressions >= 100 && row.ctr < .03 ? '<span class="risk-level medium">Высокие показы, низкий CTR</span>' : row.position > 4 && row.position <= 20 ? '<span class="risk-level">Близко к топу</span>' : '—'}</td></tr>`).join('')}</tbody></table></div>`;
  }

  function parseCsv(text: string): string[][] {
    const delimiter = [';', ',', '\t'].sort((a, b) => (text.split('\n')[0]?.split(b).length || 0) - (text.split('\n')[0]?.split(a).length || 0))[0]!;
    const rows: string[][] = []; let row: string[] = []; let cell = ''; let quoted = false;
    for (let index = 0; index < text.length; index++) { const char = text[index]!; const next = text[index + 1];
      if (char === '"' && quoted && next === '"') { cell += '"'; index++; }
      else if (char === '"') quoted = !quoted;
      else if (char === delimiter && !quoted) { row.push(cell.trim()); cell = ''; }
      else if ((char === '\n' || char === '\r') && !quoted) { if (char === '\r' && next === '\n') index++; row.push(cell.trim()); if (row.some(Boolean)) rows.push(row); row = []; cell = ''; }
      else cell += char;
    }
    row.push(cell.trim()); if (row.some(Boolean)) rows.push(row); return rows;
  }

  function mapSearchConsoleCsv(text: string): SearchConsoleRow[] {
    const rows = parseCsv(text.replace(/^\uFEFF/, '')); if (rows.length < 2) throw new Error('CSV не содержит строк данных');
    const headers = rows[0]!.map((value) => value.toLowerCase().replace(/\s+/g, ' ').trim());
    const find = (...names: string[]) => headers.findIndex((header) => names.some((name) => header === name || header.includes(name)));
    const keyIndex = find('страница', 'page', 'запрос', 'query'); const clicksIndex = find('клики', 'clicks'); const impressionsIndex = find('показы', 'impressions'); const ctrIndex = find('ctr'); const positionIndex = find('позиция', 'position');
    if ([keyIndex, clicksIndex, impressionsIndex, ctrIndex, positionIndex].some((index) => index < 0)) throw new Error('Нужны колонки: Страница/Запрос, Клики, Показы, CTR и Позиция');
    const number = (value = '') => Number(value.replace(/\s/g, '').replace('%', '').replace(',', '.')) || 0;
    return rows.slice(1).map((cells) => { const ctrRaw = cells[ctrIndex] || ''; const ctr = number(ctrRaw); return { key: cells[keyIndex] || '', clicks: number(cells[clicksIndex]), impressions: number(cells[impressionsIndex]), ctr: ctrRaw.includes('%') || ctr > 1 ? ctr / 100 : ctr, position: number(cells[positionIndex]) }; }).filter((row) => row.key).slice(0, 10_000);
  }

  function testRobots(text: string, url: URL, userAgent: string) {
    if (!text.trim()) return { allowed: true, rule: 'robots.txt отсутствует или пуст' };
    type Group = { agents: string[]; rules: Array<{ allow: boolean; pattern: string }> };
    const groups: Group[] = []; let group: Group | null = null; let hasRules = false;
    for (const raw of text.split(/\r?\n/)) {
      const line = raw.replace(/#.*$/, '').trim(); if (!line || !line.includes(':')) continue;
      const [rawKey, ...parts] = line.split(':'); const key = rawKey!.trim().toLowerCase(); const value = parts.join(':').trim();
      if (key === 'user-agent') { if (!group || hasRules) { group = { agents: [], rules: [] }; groups.push(group); hasRules = false; } group.agents.push(value.toLowerCase()); }
      if ((key === 'allow' || key === 'disallow') && group) { hasRules = true; if (value) group.rules.push({ allow: key === 'allow', pattern: value }); }
    }
    const agent = userAgent.toLowerCase(); const matching = groups.filter((item) => item.agents.some((value) => value === '*' || agent.includes(value))).map((item) => ({ item, specificity: Math.max(...item.agents.filter((value) => value === '*' || agent.includes(value)).map((value) => value === '*' ? 0 : value.length)) }));
    const specificity = Math.max(-1, ...matching.map((item) => item.specificity)); const rules = matching.filter((item) => item.specificity === specificity).flatMap((item) => item.item.rules);
    const path = `${url.pathname}${url.search}`; const escapeRegex = (value: string) => value.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*');
    const matches = rules.filter((rule) => new RegExp(`^${escapeRegex(rule.pattern).replace(/\\\$$/, '$')}`).test(path)).sort((a, b) => b.pattern.replace(/\*/g, '').length - a.pattern.replace(/\*/g, '').length || Number(b.allow) - Number(a.allow));
    const winner = matches[0]; return { allowed: winner ? winner.allow : true, rule: winner ? `${winner.allow ? 'Allow' : 'Disallow'}: ${winner.pattern}` : '' };
  }

  function renderPages(report: AuditReport) {
    const query = pageQuery.toLowerCase();
    const filtered = report.pages.filter((page, index) => {
      if (query && !`${page.url} ${page.title}`.toLowerCase().includes(query)) return false;
      if (pageStatusFilter === 'indexable' && !page.indexable) return false;
      if (pageStatusFilter === 'nonindexable' && page.indexable) return false;
      if (pageStatusFilter === 'errors' && page.status > 0 && page.status < 400) return false;
      if (pageStatusFilter === 'redirects' && !page.redirected) return false;
      if (pageStatusFilter === 'orphan' && (index === 0 || page.incomingLinks > 0)) return false;
      return true;
    });
    filtered.sort((a, b) => pageSort === 'score-asc' ? a.score - b.score : pageSort === 'response-desc' ? b.responseTime - a.responseTime : pageSort === 'depth-desc' ? b.depth - a.depth : pageSort === 'url' ? a.url.localeCompare(b.url) : b.issues.length - a.issues.length);
    $('#pages-shown').textContent = `${filtered.length} из ${report.pages.length}`;
    $('#pages-table').innerHTML = filtered.map((page) => `<tr>
      <td><a href="${escapeHtml(page.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(page.url))}</a><small>${escapeHtml(page.title || 'Title отсутствует')}</small></td>
      <td><span class="http-status ${page.status >= 400 || !page.status ? 'bad' : page.redirected ? 'redirect' : ''}">${page.redirected ? `${page.redirectChain.map((hop) => hop.status).join('→')}→${page.status}` : page.status || 'ERR'}</span></td>
      <td><span class="index-status ${page.indexable ? 'yes' : 'no'}">${page.indexable ? 'Да' : 'Нет'}</span></td><td>${page.depth < 0 ? '—' : page.depth}</td><td>${page.incomingLinks}</td>
      <td><strong class="table-score ${scoreTone(page.score)}">${page.score}</strong></td><td><strong class="table-score ${scoreTone(page.contentScore)}">${page.contentScore}</strong></td><td>${page.wordCount}</td><td>${page.issues.length}</td><td><button class="page-detail-button" type="button" data-page-index="${report.pages.indexOf(page)}">Детали</button></td>
    </tr>`).join('') || '<tr><td colspan="10" class="empty-state">Страницы не найдены.</td></tr>';
  }

  function renderArchitecture(report: AuditReport) {
    const insight = report.crawlInsights;
    const kpis: Array<[string, string | number, string, string]> = [
      ['Индексируемые', insight.indexablePages, `из ${report.pagesScanned}`, insight.nonIndexablePages ? 'warn' : 'good'],
      ['Средний ответ', `${insight.averageResponseTime} мс`, `p95: ${insight.p95ResponseTime} мс`, insight.p95ResponseTime > 2500 ? 'bad' : insight.p95ResponseTime > 1000 ? 'warn' : 'good'],
      ['Эффективность обхода', `${insight.crawlEfficiency}%`, `${report.crawl.discovered} найдено`, insight.crawlEfficiency < 25 ? 'warn' : 'good'],
      ['Макс. глубина', insight.maxDepth, `${insight.deepPages} глубже 3`, insight.deepPages ? 'warn' : 'good'],
      ['Сиротские', insight.orphanPages, 'в sitemap без ссылок', insight.orphanPages ? 'bad' : 'good'],
      ['Параметры', insight.parameterizedUrls, 'URL с query string', insight.parameterizedUrls ? 'warn' : 'good'],
    ];
    $('#architecture-kpis').innerHTML = kpis.map(([label, value, detail, tone]) => `<div><span>${escapeHtml(label)}</span><strong class="${tone}">${escapeHtml(value)}</strong><small>${escapeHtml(detail)}</small></div>`).join('');
    const statuses = [
      ['2xx', insight.statusGroups.ok, 'Успешные', 'ok'], ['3xx', insight.statusGroups.redirects, 'Редиректы', 'redirect'],
      ['4xx', insight.statusGroups.clientErrors, 'Ошибки клиента', 'bad'], ['5xx', insight.statusGroups.serverErrors, 'Ошибки сервера', 'bad'], ['ERR', insight.statusGroups.failed, 'Недоступны', 'bad'],
    ];
    $('#status-matrix').innerHTML = statuses.map(([code, count, label, tone]) => `<div><span class="${tone}">${code}</span><strong>${count}</strong><small>${label}</small></div>`).join('');
    const depthCounts = new Map<number, number>();
    report.pages.forEach((page) => depthCounts.set(page.depth, (depthCounts.get(page.depth) || 0) + 1));
    const maxCount = Math.max(1, ...depthCounts.values());
    $('#depth-chart').innerHTML = [...depthCounts.entries()].sort((a, b) => a[0] - b[0]).map(([depth, count]) => `<div><span>${depth < 0 ? 'Без пути' : `Уровень ${depth}`}</span><i><b style="width:${count / maxCount * 100}%"></b></i><strong>${count}</strong></div>`).join('');
    const findings = report.pages.filter((page, index) => page.redirected || page.depth > 3 || page.depth < 0 || !page.indexable || page.urlParameters.length > 3 || index > 0 && page.incomingLinks === 0).slice(0, 20);
    $('#architecture-findings').innerHTML = findings.length ? findings.map((page) => {
      const flags = [page.redirected && 'редирект', !page.indexable && 'не индексируется', page.depth < 0 && 'нет пути от главной', page.depth > 3 && `глубина ${page.depth}`, report.pages.indexOf(page) > 0 && page.incomingLinks === 0 && '0 входящих', page.urlParameters.length > 3 && `${page.urlParameters.length} параметров`].filter(Boolean);
      return `<div class="architecture-finding"><a href="${escapeHtml(page.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(page.url))}</a><p>${flags.map((flag) => `<span>${escapeHtml(flag)}</span>`).join('')}</p><button type="button" data-architecture-page="${report.pages.indexOf(page)}">Детали</button></div>`;
    }).join('') : '<p class="empty-state">Структурных проблем среди проверенных страниц не найдено.</p>';
    $('#sitemap-report').innerHTML = report.sitemaps.length ? report.sitemaps.map((item) => `<div><span class="http-status ${item.status >= 400 || !item.status ? 'bad' : ''}">${item.status || 'ERR'}</span><p><a href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(item.url))}</a><small>${item.type === 'index' ? 'Sitemap Index' : item.type === 'urlset' ? 'URL Sitemap' : 'Не распознана'} · ${item.urls} URL${item.invalidUrls ? ` · ${item.invalidUrls} некорректных` : ''}${item.lastmodCount ? ` · lastmod ${item.lastmodCount}` : ''}${item.invalidLastmod ? ` · дат с ошибкой ${item.invalidLastmod}` : ''}${item.futureLastmod ? ` · будущих дат ${item.futureLastmod}` : ''}${item.suspiciousUniformLastmod ? ' · одинаковые lastmod' : ''}${(item.changefreqCount || item.priorityCount) ? ` · устаревших подсказок ${(item.changefreqCount || 0) + (item.priorityCount || 0)}` : ''}${item.error ? ` · ${escapeHtml(item.error)}` : ''}</small></p></div>`).join('') : '<p class="empty-state">Карты сайта не найдены.</p>';
    const problematicLinks = report.linkChecks.filter((item) => !item.ok || item.redirectChain.length).slice(0, 20);
    const linkSummary = `<div class="crawl-report-summary"><strong>${report.linkChecks.length}</strong><span>проверено</span><strong>${report.linkChecks.filter((item) => !item.ok).length}</strong><span>недоступно</span><strong>${report.linkChecks.filter((item) => item.redirectChain.length).length}</strong><span>с редиректом</span></div>`;
    $('#link-report').innerHTML = linkSummary + (problematicLinks.length ? problematicLinks.map((item) => `<div><span class="http-status ${item.ok ? 'redirect' : 'bad'}">${item.status || 'ERR'}</span><p><a href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(item.url))}</a><small>${item.kind === 'internal' ? 'внутренняя' : 'внешняя'} · ${item.sourceUrls.length} источников${item.redirectChain.length ? ` · цепочка ${item.redirectChain.map((hop) => hop.status).join(' → ')}` : ''}${item.error ? ` · ${escapeHtml(item.error)}` : ''}</small></p></div>`).join('') : '<p class="empty-state">Недоступных и перенаправляемых ссылок не найдено.</p>');
    const risk = (value: number) => `<span class="risk-level ${value >= 2 ? 'high' : value === 1 ? 'medium' : 'low'}">${value >= 2 ? 'Высокий' : value === 1 ? 'Есть риск' : 'Низкий'}</span>`;
    $('#cwv-table').innerHTML = [...report.pages].sort((a, b) => (b.cwvRisks.lcp + b.cwvRisks.inp + b.cwvRisks.cls) - (a.cwvRisks.lcp + a.cwvRisks.inp + a.cwvRisks.cls)).map((page) => `<tr><td><a href="${escapeHtml(page.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(page.url))}</a></td><td>${page.responseTime} мс</td><td>${risk(page.cwvRisks.lcp)}</td><td>${risk(page.cwvRisks.inp)}</td><td>${risk(page.cwvRisks.cls)}</td><td>${page.domNodes}</td><td>${page.scripts}</td></tr>`).join('');
  }

  function renderIssues() {
    if (!currentReport) return;
    const normalizedQuery = issueQuery.toLowerCase();
    const filtered = currentReport.issues.filter((item) => {
      if (severityFilter !== 'all' && item.severity !== severityFilter) return false;
      if (categoryFilter !== 'all' && item.category !== categoryFilter) return false;
      if (hideResolved && resolvedIssues.has(issueFingerprint(item))) return false;
      return !normalizedQuery || `${item.title} ${item.description} ${item.url || ''}`.toLowerCase().includes(normalizedQuery);
    });
    const groups = groupIssues ? groupAuditIssues(filtered) : filtered.map((item) => [item]);
    $('#issues-list').innerHTML = groups.map((group) => issueMarkup(group[0]!, false, group)).join('') || '<p class="empty-state">Проблем этого уровня не найдено.</p>';
    $('#issues-shown').textContent = groupIssues ? `${groups.length} групп · ${filtered.length} ошибок` : `Показано: ${filtered.length}`;
    const resolvedCount = currentReport.issues.filter((item) => resolvedIssues.has(issueFingerprint(item))).length;
    $('#resolution-label').textContent = `Исправлено ${resolvedCount} из ${currentReport.issues.length}`;
    $('#resolution-bar').style.width = `${resolvedCount / Math.max(1, currentReport.issues.length) * 100}%`;
  }

  function openPageDetails(index: number) {
