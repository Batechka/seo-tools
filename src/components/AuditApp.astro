  const normalizedPageUrl = (value: string) => { try { const url = new URL(value); url.hash = ''; return url.toString().replace(/\/$/, ''); } catch { return value.replace(/\/$/, ''); } };

  function renderLinkGraph(report: AuditReport) {
    const pages = report.pages.slice(0, 18); const svg = $('#link-graph');
    if (!pages.length) { svg.innerHTML = ''; return; }
    const nodes = pages.map((page, index) => ({ page, x: 380 + Math.cos(index / pages.length * Math.PI * 2 - Math.PI / 2) * 275, y: 165 + Math.sin(index / pages.length * Math.PI * 2 - Math.PI / 2) * 120 }));
    const byUrl = new Map(nodes.map((node) => [normalizedPageUrl(node.page.url), node]));
    const lines = nodes.flatMap((node) => (node.page.outgoingInternalUrls || []).slice(0, 30).map((url) => ({ from: node, to: byUrl.get(normalizedPageUrl(url)) })).filter((edge): edge is { from: typeof node; to: typeof node } => Boolean(edge.to))).slice(0, 90);
    svg.innerHTML = `<g class="graph-lines">${lines.map((edge) => `<line x1="${edge.from.x}" y1="${edge.from.y}" x2="${edge.to.x}" y2="${edge.to.y}" />`).join('')}</g>${nodes.map((node, index) => `<g class="graph-node"><circle cx="${node.x}" cy="${node.y}" r="${index ? 11 : 15}" /><title>${escapeHtml(node.page.url)}</title><text x="${node.x}" y="${node.y + 27}" text-anchor="middle">${escapeHtml(shortUrl(node.page.url).slice(-22))}</text></g>`).join('')}`;
  }

  function linkSuggestions(report: AuditReport) {
    const suggestions: Array<{ source: PageAudit; target: PageAudit; terms: string[]; prompt: string }> = [];
    for (const source of report.pages) for (const target of report.pages) {
      if (source === target || (source.outgoingInternalUrls || []).some((url) => normalizedPageUrl(url) === normalizedPageUrl(target.url))) continue;
      const sourceTerms = new Set(source.topTerms.slice(0, 12).map((item) => item.term.toLowerCase()));
      const terms = target.topTerms.slice(0, 12).map((item) => item.term.toLowerCase()).filter((term) => sourceTerms.has(term));
      if (terms.length < 2) continue;
      const prompt = `Добавь контекстную внутреннюю ссылку со страницы ${source.url} на ${target.url}. Найди естественный абзац по теме «${terms.slice(0, 3).join(', ')}», используй описательный анкор и не меняй смысл текста. После изменения проверь ссылку, доступность и отсутствие дублирующего анкора.`;
      suggestions.push({ source, target, terms, prompt });
    }
    return suggestions.sort((a, b) => b.terms.length - a.terms.length || a.source.incomingLinks - b.source.incomingLinks).slice(0, 10);
  }

  function renderClusters(report: AuditReport) {
    const phrases = [...new Set([...report.targetKeywords, ...report.pages.map((page) => contentFor(page).primaryTopic), ...report.topTerms.slice(0, 20).map((item) => item.term)].map((item) => item.trim()).filter(Boolean))];
    const stop = new Set(['для','как','что','это','или','при','the','and','with','from']);
    const clusters: Array<{ name: string; tokens: Set<string>; phrases: string[]; pages: Set<string> }> = [];
    phrases.forEach((phrase) => {
      const tokens = new Set(phrase.toLowerCase().split(/[^a-zа-яё0-9]+/i).filter((token) => token.length > 2 && !stop.has(token)));
      let cluster = clusters.find((item) => [...tokens].some((token) => item.tokens.has(token)));
      if (!cluster) { cluster = { name: phrase, tokens: new Set(tokens), phrases: [], pages: new Set() }; clusters.push(cluster); }
      cluster.phrases.push(phrase); tokens.forEach((token) => cluster!.tokens.add(token));
      report.pages.filter((page) => [...tokens].some((token) => `${page.title} ${page.h1.join(' ')} ${page.topTerms.map((term) => term.term).join(' ')}`.toLowerCase().includes(token))).slice(0, 8).forEach((page) => cluster!.pages.add(page.url));
    });
    $('#keyword-clusters').innerHTML = clusters.slice(0, 12).map((cluster) => `<div class="tool-row"><div><strong>${escapeHtml(cluster.name)}</strong><span>${cluster.phrases.length} фраз · ${cluster.pages.size} релевантных страниц</span></div><small>${escapeHtml(cluster.phrases.slice(0, 4).join(' · '))}</small></div>`).join('') || '<p class="empty-state">Добавьте ключевые фразы при запуске аудита.</p>';
  }

  function renderIntentMap(report: AuditReport) {
    if (!report.targetKeywords.length) {
      $('#intent-map').innerHTML = '<p class="empty-state">Укажите целевые ключевые фразы перед аудитом — инструмент построит карту URL и покажет пересечения интентов.</p>';
      return;
    }
    const rows = report.targetKeywords.map((keyword) => {
      const candidates = report.pages.map((page) => {
        const metric = page.keywordMetrics.find((item) => item.keyword === keyword);
        const score = (metric?.inTitle ? 35 : 0) + (metric?.inH1 ? 30 : 0) + (metric?.inDescription ? 10 : 0) + (metric?.inFirst100Words ? 15 : 0) + Math.min(10, (metric?.count || 0) * 2);
        return { page, metric, score };
      }).filter((item) => item.score > 0).sort((a, b) => b.score - a.score);
      const primary = candidates[0];
      const competitors = candidates.filter((item) => item.score >= Math.max(45, (primary?.score || 0) - 15));
      const status = !primary ? 'Не назначена' : competitors.length > 1 ? 'Риск каннибализации' : 'Целевая страница найдена';
      const tone = !primary ? 'bad-text' : competitors.length > 1 ? 'warn-text' : 'good-text';
      const prompt = primary ? `Проведи ручную проверку интента для ключевой фразы «${keyword}». Основной кандидат: ${primary.page.url}. Конкурирующие URL: ${competitors.map((item) => item.page.url).join(', ') || 'нет'}. Сравни выдачу Яндекса/Google, title, H1, первый экран, содержание, FAQ и внутренние анкоры. Не меняй primary URL только по плотности ключа. Если интенты одинаковые — предложи объединение/301; если разные — сформулируй отдельный user job и разведи метаданные, содержание и перелинковку. Покажи решение и аргументы, не выдумывай частотность.` : `Для ключевой фразы «${keyword}» не найдена релевантная страница в проверенном наборе ${report.url}. Сначала проверь реальную частотность и интент в Wordstat/Search Console/SERP. Затем реши: доработать существующий URL, не использовать запрос или создать страницу только при самостоятельной пользовательской задаче. Не создавай thin/doorway page.`;
      return { keyword, primary, competitors, status, tone, prompt };
    });
    ($('#intent-map') as HTMLElement).dataset.prompts = JSON.stringify(rows.map((row) => row.prompt));
    $('#intent-map').innerHTML = rows.map((row, index) => `<div class="tool-row intent-row"><div><strong>${escapeHtml(row.keyword)}</strong><span>${row.primary ? escapeHtml(shortUrl(row.primary.page.url)) : 'Нет релевантного URL'}${row.competitors.length > 1 ? ` · конкурируют ${row.competitors.length} страницы` : ''}</span></div><small class="${row.tone}">${row.status}</small><button type="button" data-copy-intent="${index}">Промпт</button></div>`).join('');
  }

  async function renderProductTools(report: AuditReport, previous?: ReportSummary) {
    const suggestions = linkSuggestions(report);
    const accessibilityIssues = report.pages.reduce((sum, page) => sum + page.imagesMissingAlt + page.formsMissingLabels + page.emptyLinks + page.headingOrderIssues + (page.lang ? 0 : 1), 0);
    const accessibilityScore = Math.max(0, Math.round(100 - accessibilityIssues / Math.max(1, report.pages.length) * 8));
    const schemaPages = report.pages.filter((page) => page.schemaTypes.length).length;
    $('#tool-kpis').innerHTML = `<div><span>Доступность</span><strong class="${scoreTone(accessibilityScore)}">${accessibilityScore}</strong></div><div><span>Schema coverage</span><strong>${Math.round(schemaPages / Math.max(1, report.pages.length) * 100)}%</strong></div><div><span>Новых ссылок</span><strong>${suggestions.length}</strong></div><div><span>Исправлено</span><strong>${resolvedIssues.size}</strong></div>`;
    renderClusters(report); renderIntentMap(report); renderLinkGraph(report);
    $('#link-opportunities').innerHTML = suggestions.length ? suggestions.map((item, index) => `<div class="tool-row link-suggestion"><div><strong>${escapeHtml(shortUrl(item.source.url))} → ${escapeHtml(shortUrl(item.target.url))}</strong><span>Общие темы: ${escapeHtml(item.terms.slice(0, 4).join(', '))}</span></div><button type="button" data-copy-link="${index}">Промпт</button></div>`).join('') : '<p class="empty-state">Очевидных новых связей не найдено.</p>';
    ($('#link-opportunities') as HTMLElement).dataset.prompts = JSON.stringify(suggestions.map((item) => item.prompt));
    const accessibilityPages = report.pages.map((page) => ({ page, count: page.imagesMissingAlt + page.formsMissingLabels + page.emptyLinks + page.headingOrderIssues + (page.lang ? 0 : 1) })).filter((item) => item.count).sort((a, b) => b.count - a.count).slice(0, 12);
    $('#accessibility-report').innerHTML = `<div class="mini-summary"><strong>${accessibilityIssues}</strong><span>наблюдаемых проблем</span></div>${accessibilityPages.map(({ page, count }) => `<div class="tool-row"><div><strong>${escapeHtml(shortUrl(page.url))}</strong><span>${count} проблем · alt ${page.imagesMissingAlt} · формы ${page.formsMissingLabels} · ссылки ${page.emptyLinks} · заголовки ${page.headingOrderIssues}</span></div></div>`).join('') || '<p class="empty-state">Базовые HTML-проверки пройдены. Для WCAG запустите Lighthouse.</p>'}`;
    $('#schema-inventory').innerHTML = report.pages.map((page) => `<div class="tool-row"><div><strong>${escapeHtml(shortUrl(page.url))}</strong><span>${page.schemaTypes.length ? page.schemaTypes.map(escapeHtml).join(', ') : 'Schema не найдена'}</span></div>${page.schemaErrors.length ? `<small class="bad-text">${page.schemaErrors.length} ошибок</small>` : '<small class="good-text">валидно</small>'}</div>`).join('');
    ($('#rendered-page') as HTMLSelectElement).innerHTML = report.pages.map((page, index) => `<option value="${index}">${escapeHtml(shortUrl(page.url))}</option>`).join('');
    $('#rendered-report').innerHTML = '<p class="empty-state">Выберите страницу и загрузите её отрисованный HTML.</p>';

    const previousReport = previous ? await loadFullReport(previous.id) : null;
    if (currentReport?.id !== report.id) return;
    if (!previousReport) $('#change-report').innerHTML = '<p class="empty-state">Это первый полный аудит сайта. Следующий запуск покажет изменения каждой страницы.</p>';
    else {
      const oldPages = new Map(previousReport.pages.map((page) => [normalizedPageUrl(page.url), page]));
      const changes = report.pages.map((page) => { const old = oldPages.get(normalizedPageUrl(page.url)); if (!old) return { page, label: 'Новая страница', detail: 'URL появился в текущем аудите', good: true }; const fixed = old.issues.filter((issue) => !page.issues.some((item) => issueFingerprint(item) === issueFingerprint(issue))).length; const added = page.issues.filter((issue) => !old.issues.some((item) => issueFingerprint(item) === issueFingerprint(issue))).length; const fields = [old.title !== page.title && 'title', old.description !== page.description && 'description', old.canonical !== page.canonical && 'canonical', old.indexable !== page.indexable && 'индексация', old.wordCount !== page.wordCount && `слова ${old.wordCount}→${page.wordCount}`, old.score !== page.score && `SEO ${old.score}→${page.score}`].filter(Boolean); return fields.length || fixed || added ? { page, label: `${fixed} исправлено · ${added} новых`, detail: fields.join(', ') || 'изменился набор проблем', good: fixed > added } : null; }).filter(Boolean) as Array<{ page: PageAudit; label: string; detail: string; good: boolean }>;
      $('#change-report').innerHTML = `<div class="mini-summary"><strong>${changes.length}</strong><span>страниц изменилось с ${formatDate(previousReport.createdAt)}</span></div>${changes.slice(0, 20).map((item) => `<div class="tool-row"><div><strong>${escapeHtml(shortUrl(item.page.url))}</strong><span>${escapeHtml(item.detail)}</span></div><small class="${item.good ? 'good-text' : 'bad-text'}">${escapeHtml(item.label)}</small></div>`).join('') || '<p class="empty-state">Изменений в проверяемых сигналах нет.</p>'}`;
    }
    runCustomRules();
  }

  function runCustomRules() {
    if (!currentReport) return; const source = ($('#custom-rules') as HTMLTextAreaElement).value; localStorage.setItem('sitescan:custom-rules', source);
    const allowed: Record<string, (page: PageAudit) => number | string | boolean> = { titleLength: (p) => p.titleLength, descriptionLength: (p) => p.descriptionLength, wordCount: (p) => p.wordCount, imagesMissingAlt: (p) => p.imagesMissingAlt, indexable: (p) => p.indexable, responseTime: (p) => p.responseTime, contentScore: (p) => p.contentScore, score: (p) => p.score, internalLinks: (p) => p.internalLinks, incomingLinks: (p) => p.incomingLinks, depth: (p) => p.depth, status: (p) => p.status, h1Count: (p) => p.h1.length, schemaCount: (p) => p.schemaTypes.length, hreflangErrors: (p) => p.hreflangErrors || 0 };
    const rules = source.split(/\r?\n/).map((line) => ({ line: line.trim(), match: line.trim().match(/^(\w+)\s*(>=|<=|!=|=|>|<)\s*(.+)$/) })).filter((item) => item.line);
    const invalid = rules.filter((item) => !item.match || !allowed[item.match[1]!]); const violations: Array<{ page: PageAudit; rule: string; actual: unknown; prompt: string }> = [];
    rules.filter((item) => item.match && allowed[item.match[1]!]).forEach(({ line, match }) => { const field = match?.[1] || ''; const operator = match?.[2] || '='; const raw = match?.[3] || ''; let expected: number | boolean | string = raw.trim(); if (/^-?\d+(?:\.\d+)?$/.test(String(expected))) expected = Number(expected); else if (/^(true|false)$/i.test(String(expected))) expected = String(expected).toLowerCase() === 'true'; currentReport!.pages.forEach((page) => { const actual = allowed[field]!(page); const left = typeof actual === 'number' ? actual : String(actual); const right = typeof actual === 'number' ? Number(expected) : String(expected); const pass = operator === '>=' ? left >= right : operator === '<=' ? left <= right : operator === '>' ? left > right : operator === '<' ? left < right : operator === '!=' ? left !== right : left === right; if (!pass) violations.push({ page, rule: line, actual, prompt: `Исправь страницу ${page.url}, чтобы она прошла пользовательское SEO-правило «${line}». Сейчас ${field} = ${String(actual)}. Сначала найди общий шаблон, не выдумывай факты и после изменения проверь HTML, типизацию и сборку.` }); }); });
    customRulePrompts = violations.map((item) => item.prompt);
    $('#custom-rules-report').innerHTML = `${invalid.length ? `<p class="integration-error">Не распознано правил: ${invalid.map((item) => escapeHtml(item.line)).join(', ')}</p>` : ''}<div class="mini-summary"><strong>${violations.length}</strong><span>нарушений на ${currentReport.pages.length} страницах</span></div>${violations.slice(0, 15).map((item, index) => `<div class="tool-row"><div><strong>${escapeHtml(shortUrl(item.page.url))}</strong><span>${escapeHtml(item.rule)} · сейчас ${escapeHtml(item.actual)}</span></div><button type="button" data-copy-custom="${index}">Промпт</button></div>`).join('') || '<p class="empty-state">Все пользовательские правила пройдены.</p>'}`;
