    $('#content-risks').innerHTML = `<div><strong>${weakIntent}</strong><span>страниц со слабым интентом</span></div><div><strong>${lowExperience}</strong><span>без убедительного опыта</span></div><div><strong>${repetition}</strong><span>с риском повторов</span></div><div><strong>${report.pages.filter((page) => contentFor(page).dimensions.expertise < 55).length}</strong><span>со слабой экспертностью</span></div>`;

    $('#keyword-report').innerHTML = report.keywordSummary.length ? `<div class="keyword-table">
