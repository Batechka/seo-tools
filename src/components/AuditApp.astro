---
import { Activity, ArrowRight, Bot, Braces, Check, ChevronDown, Download, FileSearch, FileSpreadsheet, Gauge, Globe, History, ListChecks, Network, Search, ShieldCheck, Sparkles, X } from '@lucide/astro';
---
<div class="shell">
  <a class="skip-link" href="#main-content">Перейти к основному содержанию</a>
  <header class="topbar">
    <a class="brand" href="/" aria-label="SiteScan — на главную">
      <span class="brand-mark"><Activity size={17} stroke-width={2.4} /></span>
      <span>SITE<span>SCAN</span></span>
    </a>
    <div class="topbar-meta">
      <span class="status-dot" aria-hidden="true"></span>
      Локальный инструмент
      <span class="topbar-divider" aria-hidden="true"></span>
      Без передачи истории
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="audit-start">
      <div class="eyebrow"><span>01</span> Технический SEO-аудит</div>
      <div class="hero-grid">
        <div>
          <h1>Увидеть сайт<br />глазами поисковика.</h1>
          <p class="hero-copy">SiteScan проходит по страницам, находит то, что мешает индексации и росту, расставляет задачи по приоритету и собирает понятный PDF-отчёт.</p>
        </div>
        <div class="hero-aside" aria-label="Возможности аудита">
          <p>Проверяет</p>
          <ul>
            <li><Check size={14} /> Индексацию и техническое SEO</li>
            <li><Check size={14} /> Мета-теги, контент и ссылки</li>
            <li><Check size={14} /> Изображения и Schema.org</li>
            <li><Check size={14} /> Готовность к AI-поиску</li>
          </ul>
        </div>
      </div>

      <form class="audit-form" id="audit-form">
        <label for="site-url">Адрес сайта</label>
        <div class="input-row">
          <div class="url-field">
            <Globe size={20} aria-hidden="true" />
            <input id="site-url" name="url" type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="example.com или https://example.com" required />
          </div>
          <label class="limit-field">
            <span>Страниц</span>
            <select id="crawl-limit" name="limit" aria-label="Максимум страниц для проверки">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
            <ChevronDown size={15} aria-hidden="true" />
          </label>
          <button class="primary-button" type="submit">
            <Search size={18} />
            Начать аудит
            <ArrowRight size={17} />
          </button>
        </div>
        <label class="keyword-field" for="target-keywords">
          <span>Целевые ключевые фразы <small>необязательно, до 10 через запятую</small></span>
          <input id="target-keywords" name="keywords" type="text" autocomplete="off" placeholder="например: seo аудит, продвижение сайта, техническое seo" />
        </label>
        <div class="form-foot">
          <p><ShieldCheck size={14} /> Запросы выполняются с вашего компьютера. Приватные адреса защищённо блокируются.</p>
          <button type="button" class="text-button" id="demo-button">Посмотреть пример отчёта</button>
        </div>
      </form>
    </section>

    <section class="process-strip" aria-label="Этапы проверки">
      <div><span>01</span><strong>Сканирование</strong><small>до 100 страниц</small></div>
      <div><span>02</span><strong>Диагностика</strong><small>более 100 сигналов</small></div>
      <div><span>03</span><strong>Приоритеты</strong><small>что исправлять первым</small></div>
      <div><span>04</span><strong>PDF-отчёт</strong><small>готов к сохранению</small></div>
    </section>

    <section class="history-panel" id="history-panel" hidden>
      <div class="history-head"><div><History size={20} /><div><span>ЛОКАЛЬНАЯ ИСТОРИЯ</span><h2>Последние аудиты</h2></div></div><div class="history-actions"><button type="button" id="history-toggle" hidden>Показать все</button><button type="button" id="clear-history">Очистить</button></div></div>
      <div class="history-list" id="history-list"></div>
    </section>

    <section class="loading-panel" id="loading-panel" hidden aria-live="polite">
      <div class="scan-visual" aria-hidden="true">
        <div class="scan-grid"></div>
        <div class="scan-line"></div>
        <FileSearch size={42} />
      </div>
      <div>
        <p class="eyebrow"><span>LIVE</span> Анализ сайта</p>
        <h2 id="loading-title">Подключаемся к сайту…</h2>
        <p id="loading-message">Проверяем доступность, robots.txt и sitemap.xml.</p>
        <div class="progress-track"><span id="progress-bar"></span></div>
        <p class="loading-live-metrics" id="loading-metrics">Подготовка сканера…</p>
        <div class="loading-steps">
          <span class="active">Доступность</span><span>Страницы</span><span>SEO-сигналы</span><span>Отчёт</span>
        </div>
        <button class="cancel-audit" type="button" id="cancel-audit"><X size={15} /> Отменить аудит</button>
      </div>
    </section>

    <section class="error-panel" id="error-panel" hidden role="alert">
      <div class="error-code">!</div>
      <div><strong>Аудит не запустился</strong><p id="error-message"></p></div>
      <button type="button" id="retry-button">Попробовать снова</button>
    </section>

    <section class="results" id="results" hidden aria-live="polite">
      <div class="results-head">
        <div>
          <p class="eyebrow"><span>REPORT</span> Аудит завершён</p>
          <h2>SEO-здоровье сайта</h2>
          <p class="report-url" id="report-url"></p>
        </div>
        <div class="results-actions">
          <button class="secondary-button" type="button" id="new-audit"><Search size={16} /> Новый аудит</button>
          <button class="icon-export" type="button" id="export-json" title="Скачать JSON" aria-label="Скачать данные отчёта в JSON"><Braces size={17} /></button>
          <button class="icon-export" type="button" id="export-csv" title="Скачать CSV" aria-label="Скачать таблицу страниц в CSV"><FileSpreadsheet size={17} /></button>
          <button class="icon-export codex-export" type="button" id="export-codex" title="Скачать план для Codex" aria-label="Скачать план исправлений для Codex"><Bot size={18} /></button>
          <button class="primary-button compact" type="button" id="download-pdf"><Download size={17} /> Скачать PDF</button>
        </div>
      </div>

      <div class="scoreboard">
        <div class="score-main">
          <div class="score-ring" id="score-ring">
            <strong id="score-value">0</strong><span>/ 100</span>
          </div>
          <div><span class="grade" id="score-grade">—</span><h3 id="score-label">Оценка сайта</h3><p id="score-summary"></p></div>
        </div>
        <dl class="summary-stats">
          <div><dt>Проверено</dt><dd id="pages-count">0</dd><small>страниц</small></div>
          <div><dt>Критично</dt><dd class="critical-text" id="critical-count">0</dd><small>ошибок</small></div>
          <div><dt>Высокий риск</dt><dd class="high-text" id="high-count">0</dd><small>ошибок</small></div>
          <div><dt>Время</dt><dd id="duration-value">0</dd><small>секунд</small></div>
        </dl>
      </div>

      <section class="comparison-strip" id="comparison-strip" hidden>
        <div><span>СРАВНЕНИЕ</span><strong>Изменения с прошлого аудита</strong><small id="comparison-date"></small></div>
        <div><span>Оценка</span><strong id="compare-score">—</strong></div>
        <div><span>Всего ошибок</span><strong id="compare-issues">—</strong></div>
        <div><span>Критичных</span><strong id="compare-critical">—</strong></div>
        <div><span>Страниц</span><strong id="compare-pages">—</strong></div>
      </section>

      <div class="section-nav" role="tablist" aria-label="Разделы отчёта">
        <button class="active" role="tab" aria-selected="true" data-tab="overview">Обзор</button>
        <button role="tab" aria-selected="false" data-tab="issues">Все ошибки <span id="issues-badge">0</span></button>
        <button role="tab" aria-selected="false" data-tab="content">Ключи и контент</button>
        <button role="tab" aria-selected="false" data-tab="pages">Страницы</button>
        <button role="tab" aria-selected="false" data-tab="architecture">Архитектура</button>
        <button role="tab" aria-selected="false" data-tab="technical">Техническое</button>
        <button role="tab" aria-selected="false" data-tab="tools">Инструменты</button>
      </div>

      <div class="tab-panel" id="tab-content" role="tabpanel" hidden>
        <div class="content-kpis" id="content-kpis"></div>
        <section class="data-section content-dimension-section">
          <div class="section-title"><div><span>CONTENT QUALITY MODEL</span><h3>Качество сайта по 10 измерениям</h3></div><span class="heuristic-badge">объяснимая эвристика</span></div>
          <div class="content-dimension-grid" id="content-dimensions"></div>
          <div class="content-risk-strip" id="content-risks"></div>
        </section>
        <div class="content-layout">
          <section class="data-section keywords-section">
            <div class="section-title"><div><span>СЕМАНТИКА</span><h3>Целевые ключевые фразы</h3></div></div>
            <div id="keyword-report"></div>
          </section>
          <section class="data-section">
            <div class="section-title"><div><span>ЧАСТОТНОСТЬ</span><h3>Главные термины сайта</h3></div></div>
            <div class="term-list" id="top-terms"></div>
          </section>
        </div>
        <section class="data-section content-pages-section">
          <div class="section-title"><div><span>СТРАНИЦЫ</span><h3>Качество контента</h3></div></div>
          <div class="table-wrap borderless">
            <table><thead><tr><th>URL / тип</th><th>Контент</th><th>Интент</th><th>Полнота</th><th>Опыт</th><th>Экспертность</th><th>Доверие</th><th>AI</th><th>Проверки</th><th>Слова</th><th></th></tr></thead><tbody id="content-pages-table"></tbody></table>
          </div>
        </section>
        <div class="content-layout lower">
          <section class="data-section">
            <div class="section-title"><div><span>ДУБЛИКАТЫ</span><h3>Повторяющиеся элементы</h3></div></div>
            <div id="duplicate-report" class="plain-list"></div>
          </section>
          <section class="data-section">
            <div class="section-title"><div><span>ПЕРЕЛИНКОВКА</span><h3>Популярные анкоры</h3></div></div>
            <div id="anchor-report" class="plain-list"></div>
          </section>
        </div>
        <section class="data-section import-section">
          <div class="section-title"><div><span>SEARCH CONSOLE</span><h3>Поисковые возможности из CSV</h3></div><label class="file-action">Импорт CSV<input id="gsc-import" type="file" accept=".csv,text/csv" /></label></div>
          <p class="architecture-note">Экспортируйте таблицу «Страницы» или «Запросы» из Google Search Console. Файл разбирается только в браузере и добавляет клики, показы, CTR и позицию к локальному отчёту.</p>
          <div id="gsc-report"><p class="empty-state">CSV ещё не загружен.</p></div>
        </section>
      </div>

      <div class="tab-panel" id="tab-overview" role="tabpanel">
        <div class="overview-grid">
          <section class="category-panel">
            <div class="section-title"><div><span>ОЦЕНКИ</span><h3>По направлениям</h3></div><Gauge size={22} /></div>
            <div id="category-scores" class="category-scores"></div>
          </section>
          <section class="priority-panel">
            <div class="section-title"><div><span>ПЛАН РАБОТ</span><h3>Сначала исправьте это</h3></div><Sparkles size={21} /></div>
            <div id="priority-issues"></div>
            <button class="show-all" type="button" data-open-tab="issues">Показать все ошибки <ArrowRight size={15} /></button>
          </section>
        </div>
      </div>

      <div class="tab-panel" id="tab-issues" role="tabpanel" hidden>
        <div class="issues-toolbar">
          <div class="issue-filter-stack">
            <div class="filter-group" aria-label="Фильтр ошибок">
              <button class="active" data-filter="all">Все</button>
              <button data-filter="critical">Критичные</button>
              <button data-filter="high">Высокие</button>
              <button data-filter="medium">Средние</button>
              <button data-filter="low">Низкие</button>
            </div>
            <div class="advanced-filters">
              <label><Search size={14} /><input id="issue-search" type="search" placeholder="Найти проблему или URL" /></label>
              <select id="category-filter" aria-label="Фильтр по категории"><option value="all">Все категории</option><option value="indexing">Индексация</option><option value="onpage">On-page</option><option value="content">Контент</option><option value="links">Ссылки</option><option value="images">Изображения</option><option value="schema">Schema.org</option><option value="performance">Скорость</option><option value="social">Соцсети</option><option value="ai">AI-поиск</option></select>
              <label class="resolved-toggle"><input id="hide-resolved" type="checkbox" /> Скрыть исправленные</label>
              <label class="resolved-toggle"><input id="group-issues" type="checkbox" checked /> Группировать</label>
            </div>
          </div>
          <div class="issues-tools"><p id="issues-shown"></p><button type="button" id="download-master-prompt"><Download size={15} /> Скачать общий план .md</button></div>
        </div>
        <div class="resolution-progress"><div><ListChecks size={16} /><span id="resolution-label">Исправлено 0 из 0</span></div><i><b id="resolution-bar"></b></i></div>
        <div class="issues-list" id="issues-list"></div>
      </div>

      <div class="tab-panel" id="tab-pages" role="tabpanel" hidden>
        <div class="page-toolbar">
          <label><Search size={14} /><input id="page-search" type="search" placeholder="Найти URL или title…" /></label>
          <select id="page-status-filter" aria-label="Фильтр страниц"><option value="all">Все страницы</option><option value="indexable">Индексируемые</option><option value="nonindexable">Не индексируются</option><option value="errors">Ошибки HTTP</option><option value="redirects">Редиректы</option><option value="orphan">Без входящих ссылок</option></select>
          <select id="page-sort" aria-label="Сортировка страниц"><option value="issues">Сначала проблемные</option><option value="score-asc">SEO: хуже сначала</option><option value="response-desc">Самые медленные</option><option value="depth-desc">Самые глубокие</option><option value="url">По URL</option></select>
          <span id="pages-shown"></span>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>URL / title</th><th>Статус</th><th>Индекс</th><th>Глубина</th><th>Входящие</th><th>SEO</th><th>Контент</th><th>Слова</th><th>Проблемы</th><th></th></tr></thead>
            <tbody id="pages-table"></tbody>
          </table>
        </div>
      </div>

      <div class="tab-panel" id="tab-architecture" role="tabpanel" hidden>
        <div class="architecture-head"><div><span>CRAWL INTELLIGENCE</span><h3>Архитектура и обход сайта</h3><p>Глубина, доступность, индексируемость и вероятные ловушки краулера.</p></div><Network size={28} /></div>
        <div class="architecture-kpis" id="architecture-kpis"></div>
        <div class="architecture-layout">
          <section class="data-section"><div class="section-title"><div><span>HTTP</span><h3>Распределение ответов</h3></div></div><div id="status-matrix" class="status-matrix"></div></section>
          <section class="data-section"><div class="section-title"><div><span>ГЛУБИНА</span><h3>Уровни от главной</h3></div></div><div id="depth-chart" class="depth-chart"></div></section>
        </div>
        <section class="data-section architecture-findings"><div class="section-title"><div><span>ТРЕБУЮТ ВНИМАНИЯ</span><h3>Проблемные URL структуры</h3></div></div><div id="architecture-findings"></div></section>
        <div class="architecture-layout detail-layout">
          <section class="data-section"><div class="section-title"><div><span>SITEMAP EXPLORER</span><h3>Карты сайта</h3></div></div><div id="sitemap-report" class="crawl-report-list"></div></section>
          <section class="data-section"><div class="section-title"><div><span>LINK CHECKER</span><h3>Проверка ссылок</h3></div></div><div id="link-report" class="crawl-report-list"></div></section>
        </div>
        <section class="data-section cwv-section"><div class="section-title"><div><span>CORE WEB VITALS</span><h3>Эвристические риски LCP, INP и CLS</h3></div><div class="inline-actions"><select id="pagespeed-strategy" aria-label="Устройство PageSpeed"><option value="mobile">Mobile</option><option value="desktop">Desktop</option></select><button type="button" id="run-pagespeed">Запустить PageSpeed</button></div></div><p class="architecture-note">HTML-эвристика ниже не является полевыми Core Web Vitals. Кнопка PageSpeed запускает отдельный официальный Lighthouse lab-тест выбранной страницы.</p><div id="pagespeed-report" class="pagespeed-report" hidden></div><div class="table-wrap borderless"><table><thead><tr><th>URL</th><th>Ответ</th><th>LCP риск</th><th>INP риск</th><th>CLS риск</th><th>DOM</th><th>Скрипты</th></tr></thead><tbody id="cwv-table"></tbody></table></div></section>
      </div>

      <div class="tab-panel" id="tab-technical" role="tabpanel" hidden>
        <div class="technical-grid" id="technical-grid"></div>
        <section class="data-section robots-tester"><div class="section-title"><div><span>ROBOTS TESTER</span><h3>Проверить URL для поискового робота</h3></div></div><div class="tester-form"><input id="robots-test-url" type="url" placeholder="https://example.com/catalog/page" /><select id="robots-user-agent" aria-label="Поисковый робот"><option value="Googlebot">Googlebot</option><option value="Googlebot-Image">Googlebot-Image</option><option value="Bingbot">Bingbot</option><option value="GPTBot">GPTBot</option><option value="ChatGPT-User">ChatGPT-User</option></select><button type="button" id="test-robots">Проверить</button></div><div id="robots-test-result" class="tester-result">Введите URL текущего сайта.</div></section>
        <p class="method-note"><strong>Важно:</strong> SiteScan анализирует HTML и серверные сигналы. Оценка скорости здесь — диагностическая подсказка, а не замена полевым данным Core Web Vitals из Search Console.</p>
      </div>

      <div class="tab-panel" id="tab-tools" role="tabpanel" hidden>
        <div class="tools-hero"><div><span>PRODUCT LAB</span><h3>Рабочая зона SEO-специалиста</h3><p>Тринадцать инструментов поверх краулинга: от карты интентов и логов до контроля исправлений.</p></div><Braces size={30} /></div>
        <div class="tool-kpis" id="tool-kpis"></div>
        <div class="tools-grid">
          <section class="tool-card tool-card-wide"><div class="section-title"><div><span>CHANGE TRACKING</span><h3>Что изменилось между аудитами</h3></div><button type="button" id="verify-fixes">Проверить исправления</button></div><div id="change-report" class="tool-output"></div></section>
          <section class="tool-card"><div class="section-title"><div><span>KEYWORD CLUSTERS</span><h3>Кластеры тем и интенты</h3></div></div><div id="keyword-clusters" class="tool-output"></div></section>
          <section class="tool-card tool-card-wide"><div class="section-title"><div><span>INTENT MAP</span><h3>Карта интентов и каннибализация</h3></div></div><p class="tool-note">SiteScan назначает вероятную целевую страницу для каждого заданного ключа. Решение нужно подтвердить Wordstat, Search Console и ручной проверкой выдачи.</p><div id="intent-map" class="tool-output"></div></section>
          <section class="tool-card"><div class="section-title"><div><span>SCHEMA INSPECTOR</span><h3>Разметка по страницам</h3></div></div><div id="schema-inventory" class="tool-output"></div></section>
          <section class="tool-card tool-card-wide"><div class="section-title"><div><span>INTERNAL LINKS</span><h3>Карта и новые связи</h3></div></div><svg id="link-graph" class="link-graph" viewBox="0 0 760 330" role="img" aria-label="Граф внутренних ссылок"></svg><div id="link-opportunities" class="tool-output"></div></section>
          <section class="tool-card"><div class="section-title"><div><span>ACCESSIBILITY</span><h3>Доступность контента</h3></div></div><div id="accessibility-report" class="tool-output"></div></section>
          <section class="tool-card"><div class="section-title"><div><span>CONTENT GAP</span><h3>Сравнение с конкурентом</h3></div><label class="file-action">Импорт JSON<input id="competitor-import" type="file" accept=".json,application/json" /></label></div><p class="tool-note">Загрузите JSON-отчёт SiteScan конкурента.</p><div id="content-gap-report" class="tool-output"><p class="empty-state">Отчёт конкурента ещё не загружен.</p></div></section>
          <section class="tool-card"><div class="section-title"><div><span>CUSTOM RULES</span><h3>Собственные проверки</h3></div></div><textarea id="custom-rules" class="rule-editor" spellcheck="false" aria-label="Пользовательские правила">titleLength &gt;= 30
descriptionLength &gt;= 70
wordCount &gt;= 300
imagesMissingAlt = 0
indexable = true</textarea><button type="button" id="run-custom-rules">Запустить правила</button><div id="custom-rules-report" class="tool-output"></div></section>
          <section class="tool-card"><div class="section-title"><div><span>SERVER LOGS</span><h3>Поисковые роботы в логах</h3></div><label class="file-action">Импорт лога<input id="log-import" type="file" accept=".log,.txt,.csv,text/plain,text/csv" /></label></div><p class="tool-note">Common/Combined access log, до 20 МБ. Обрабатывается локально.</p><div id="log-report" class="tool-output"><p class="empty-state">Лог ещё не загружен.</p></div></section>
          <section class="tool-card"><div class="section-title"><div><span>RENDERED HTML</span><h3>Исходный и отрисованный DOM</h3></div></div><select id="rendered-page" class="tool-select" aria-label="Страница для сравнения"></select><label class="file-drop">Загрузить сохранённый HTML после выполнения JavaScript<input id="rendered-import" type="file" accept=".html,.htm,text/html" /></label><p class="tool-note">Сохраните отрисованный DOM в DevTools. SiteScan сравнит title, H1, canonical, robots, текст и ссылки.</p><div id="rendered-report" class="tool-output"></div></section>
          <section class="tool-card"><div class="section-title"><div><span>MONITORING</span><h3>Контроль по расписанию</h3></div></div><div class="monitor-controls"><select id="monitor-interval" class="tool-select" aria-label="Интервал мониторинга"><option value="15">каждые 15 минут</option><option value="60">каждый час</option><option value="360">каждые 6 часов</option><option value="1440">раз в сутки</option></select><button type="button" id="monitor-toggle">Включить</button></div><p class="tool-note">Локальный режим работает, пока эта вкладка SiteScan открыта.</p><div id="monitor-status" class="monitor-status">Мониторинг выключен.</div></section>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="brand"><span class="brand-mark"><Activity size={16} /></span><span>SITE<span>SCAN</span></span></div>
    <p>Локальный SEO-аудитор. Без аккаунтов и трекеров. История хранится только в вашем браузере.</p>
    <span>v2.0</span>
  </footer>
  <div class="copy-toast" id="copy-toast" role="status" aria-live="polite" hidden>Промпт скопирован</div>
  <dialog class="page-dialog" id="page-dialog">
    <div class="dialog-head"><div><span>ДЕТАЛИ СТРАНИЦЫ</span><h2 id="dialog-title">Страница</h2></div><button type="button" id="close-dialog" aria-label="Закрыть"><X size={20} /></button></div>
    <div id="page-dialog-content"></div>
  </dialog>
</div>

<script>
  import type { AuditIssue, AuditProgress, AuditReport, ContentAnalysis, PageAudit, SearchConsoleRow } from '../lib/types';
  import { buildGroupedIssuePrompt, buildMasterAuditPrompt, groupAuditIssues } from '../lib/issue-planning';

  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const form = $('#audit-form') as HTMLFormElement;
  const loading = $('#loading-panel');
  const results = $('#results');
  const errorPanel = $('#error-panel');
  const input = $('#site-url') as HTMLInputElement;
  const limit = $('#crawl-limit') as HTMLSelectElement;
  const keywordInput = $('#target-keywords') as HTMLInputElement;
  let currentReport: AuditReport | null = null;
  let progressTimer: number | undefined;
  let activeController: AbortController | null = null;
  let severityFilter = 'all';
  let issueQuery = '';
  let categoryFilter = 'all';
  let hideResolved = false;
  let groupIssues = true;
  let pageQuery = '';
  let pageStatusFilter = 'all';
  let pageSort = 'issues';
  let resolvedIssues = new Set<string>();
  let historyExpanded = false;
  let monitorTimer: number | undefined;
  let customRulePrompts: string[] = [];
  const historyKey = 'sitescan:audit-history:v1';
  type ReportSummary = Pick<AuditReport, 'id' | 'url' | 'origin' | 'createdAt' | 'score' | 'grade' | 'pagesScanned' | 'totals' | 'categoryScores'>;

  const categoryLabels: Record<string, string> = { indexing: 'Индексация', onpage: 'On-page SEO', content: 'Контент', links: 'Внутренние ссылки', images: 'Изображения', schema: 'Schema.org', performance: 'Скорость и UX', social: 'Соцсети', ai: 'AI-поиск' };
  const severityLabels: Record<string, string> = { critical: 'Критично', high: 'Высокий', medium: 'Средний', low: 'Низкий' };
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]!);
  const shortUrl = (value: string) => { try { const url = new URL(value); return url.pathname === '/' ? url.hostname : `${url.hostname}${url.pathname}`; } catch { return value; } };
  const scoreTone = (score: number) => score >= 80 ? 'good' : score >= 60 ? 'warn' : 'bad';
  const contentFor = (page: PageAudit): ContentAnalysis => page.contentAnalysis || { score: page.contentScore, pageType: 'landing', searchIntent: 'mixed', minimumWords: 600, grade: page.contentScore >= 75 ? 'B' : page.contentScore >= 60 ? 'C' : 'D', readingTime: Math.max(1, Math.ceil(page.wordCount / 200)), sentenceCount: 0, averageSentenceWords: 0, longSentencePercent: 0, primaryTopic: page.h1[0] || page.title, firstParagraph: '', outline: page.h1.map((heading) => `H1: ${heading}`), ctaFound: false, sourceLinks: page.externalLinks, factsAndNumbers: 0, repetitionRisk: 0, dimensions: { intent: page.score, depth: page.contentScore, structure: page.contentScore, readability: page.readabilityScore, originality: 70, experience: page.authorFound ? 65 : 35, expertise: page.authorFound ? 65 : 40, trust: Math.round(page.trustSignals / 6 * 100), keywordUse: 70, aiReadiness: page.aiCitationScore }, strengths: [], weaknesses: [], recommendations: ['Повторите аудит, чтобы получить новую расширенную модель контента.'], checks: [], codexPrompt: `Повтори SEO-аудит страницы ${page.url}, чтобы получить расширенный промпт исправления контента.` };
  const issueFingerprint = (item: AuditIssue) => `${item.title}|${item.url || ''}`;
  const resolvedKey = (report: AuditReport) => `sitescan:resolved:${new URL(report.origin).hostname}`;
  const readHistory = (): ReportSummary[] => { try { return JSON.parse(localStorage.getItem(historyKey) || '[]'); } catch { return []; } };
  const reportSummary = (report: AuditReport): ReportSummary => ({ id: report.id, url: report.url, origin: report.origin, createdAt: report.createdAt, score: report.score, grade: report.grade, pagesScanned: report.pagesScanned, totals: report.totals, categoryScores: report.categoryScores });
  const formatDate = (value: string) => new Intl.DateTimeFormat('ru-RU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(value));
  const reportDb = () => new Promise<IDBDatabase>((resolve, reject) => {
    const request = indexedDB.open('sitescan-reports', 1);
    request.onupgradeneeded = () => { if (!request.result.objectStoreNames.contains('reports')) request.result.createObjectStore('reports', { keyPath: 'id' }); };
    request.onsuccess = () => resolve(request.result); request.onerror = () => reject(request.error);
  });
  async function saveFullReport(report: AuditReport) { const db = await reportDb(); await new Promise<void>((resolve, reject) => { const transaction = db.transaction('reports', 'readwrite'); transaction.objectStore('reports').put(report); transaction.oncomplete = () => resolve(); transaction.onerror = () => reject(transaction.error); transaction.onabort = () => reject(transaction.error); }); db.close(); }
  async function loadFullReport(id: string) { const db = await reportDb(); return new Promise<AuditReport | null>((resolve) => { const request = db.transaction('reports').objectStore('reports').get(id); request.onsuccess = () => { resolve(request.result || null); db.close(); }; request.onerror = () => { resolve(null); db.close(); }; }); }
  async function clearFullReports() { const db = await reportDb(); const transaction = db.transaction('reports', 'readwrite'); transaction.objectStore('reports').clear(); transaction.oncomplete = () => db.close(); }

  function showLoading() {
    results.hidden = true; errorPanel.hidden = true; loading.hidden = false;
    loading.scrollIntoView({ behavior: 'smooth', block: 'center' });
    $('#progress-bar').style.width = '5%';
    $('#loading-title').textContent = 'Подключаемся к сайту…';
    $('#loading-message').textContent = 'Проверяем адрес, robots.txt и карты сайта.';
    $('#loading-metrics').textContent = 'Подготовка сканера…';
  }

  function updateLiveProgress(progress: AuditProgress) {
    const phaseStart: Record<AuditProgress['phase'], number> = { prepare: 6, sitemaps: 16, crawl: 30, links: 68, analyze: 94, complete: 100 };
    let percent = phaseStart[progress.phase];
    if (progress.phase === 'crawl') percent += Math.min(35, progress.crawled / Math.max(1, Number(limit.value)) * 35);
    if (progress.phase === 'links') percent += Math.min(22, progress.checkedLinks / Math.max(1, progress.totalLinks) * 22);
    $('#progress-bar').style.width = `${Math.min(100, percent)}%`;
    $('#loading-title').textContent = progress.phase === 'sitemaps' ? 'Читаем карты сайта…' : progress.phase === 'crawl' ? 'Сканируем страницы…' : progress.phase === 'links' ? 'Проверяем ссылки…' : progress.phase === 'analyze' ? 'Собираем отчёт…' : progress.message;
    $('#loading-message').textContent = progress.currentUrl ? shortUrl(progress.currentUrl) : progress.message;
    $('#loading-metrics').textContent = `${progress.crawled} страниц · ${progress.discovered} URL найдено · ${progress.checkedLinks}/${progress.totalLinks} ссылок`;
    const phaseIndex = { prepare: 0, sitemaps: 0, crawl: 1, links: 2, analyze: 3, complete: 3 }[progress.phase];
    document.querySelectorAll<HTMLElement>('.loading-steps span').forEach((step, index) => step.classList.toggle('active', index <= phaseIndex));
  }

  function stopLoading() {
    window.clearInterval(progressTimer);
    $('#progress-bar').style.width = '100%';
    window.setTimeout(() => { loading.hidden = true; }, 180);
  }

  async function run(payload: { url?: string; limit?: number; keywords?: string; demo?: boolean }) {
    activeController?.abort();
    const controller = new AbortController();
    activeController = controller;
    showLoading();
    try {
      const endpoint = payload.demo ? '/api/audit' : '/api/audit-stream';
      const response = await fetch(endpoint, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload), signal: controller.signal });
      if (!response.ok) { const data = await response.json().catch(() => ({})); throw new Error(data.error || 'Не удалось выполнить аудит'); }
      let report: AuditReport | null = null;
      if (payload.demo) report = await response.json() as AuditReport;
      else {
        const reader = response.body?.getReader(); if (!reader) throw new Error('Браузер не поддерживает потоковый отчёт');
        const decoder = new TextDecoder(); let buffer = '';
        while (true) {
          const { value, done } = await reader.read(); buffer += decoder.decode(value || new Uint8Array(), { stream: !done });
          const lines = buffer.split('\n'); buffer = lines.pop() || '';
          for (const line of lines.filter(Boolean)) {
            const event = JSON.parse(line);
            if (event.type === 'progress') updateLiveProgress(event.progress as AuditProgress);
            if (event.type === 'report') report = event.report as AuditReport;
            if (event.type === 'error') throw new Error(event.error || 'Не удалось выполнить аудит');
          }
          if (done) break;
        }
        if (buffer.trim()) {
          const event = JSON.parse(buffer);
          if (event.type === 'progress') updateLiveProgress(event.progress as AuditProgress);
          if (event.type === 'report') report = event.report as AuditReport;
          if (event.type === 'error') throw new Error(event.error || 'Не удалось выполнить аудит');
        }
      }
      if (!report) throw new Error('Сервер не вернул отчёт');
      currentReport = report;
      renderReport(currentReport);
      stopLoading();
      window.setTimeout(() => { results.hidden = false; results.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 190);
    } catch (error) {
      stopLoading();
      if (error instanceof DOMException && error.name === 'AbortError') return;
      $('#error-message').textContent = error instanceof Error ? error.message : 'Неизвестная ошибка';
      errorPanel.hidden = false;
      errorPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally { if (activeController === controller) activeController = null; }
  }

  function issueMarkup(item: AuditIssue, compact = false, group: AuditIssue[] = [item]) {
    const resolved = group.every((issue) => resolvedIssues.has(issueFingerprint(issue)));
    const groupIds = encodeURIComponent(group.map((issue) => issue.id).join(','));
    return `<article class="issue-row ${escapeHtml(item.severity)} ${resolved ? 'resolved' : ''}">
      <div class="severity-mark" aria-hidden="true"></div>
      <div class="issue-copy">
        ${compact ? '' : `<label class="issue-resolved"><input type="checkbox" ${group.length > 1 ? `data-resolve-group="${groupIds}"` : `data-resolve-issue="${escapeHtml(item.id)}"`} ${resolved ? 'checked' : ''} /><span>${resolved ? 'Исправлено' : 'Отметить исправленным'}</span></label>`}
        <div class="issue-meta"><span>${escapeHtml(severityLabels[item.severity])}</span><span>${escapeHtml(categoryLabels[item.category])}</span>${group.length > 1 ? `<span>${group.length} URL</span>` : ''}</div>
        <h4>${escapeHtml(item.title)}</h4>
        <p>${escapeHtml(item.description)}</p>
        ${compact ? '' : `<div class="recommendation"><strong>Как исправить</strong><p>${escapeHtml(item.recommendation)}</p></div>
          <details class="solution-details"><summary>Пошаговое решение и промпт для Codex</summary>
            <div class="solution-body"><ol>${item.solutionSteps.map((step) => `<li>${escapeHtml(step)}</li>`).join('')}</ol>
            <div class="codex-prompt"><div><strong>${group.length > 1 ? 'Один промпт для всей группы' : 'Готовый промпт'}</strong><button type="button" ${group.length > 1 ? `data-copy-issue-group="${groupIds}"` : `data-copy-issue="${escapeHtml(item.id)}"`}>Скопировать</button></div><pre>${escapeHtml(group.length > 1 ? buildGroupedIssuePrompt(group, currentReport?.url) : item.codexPrompt)}</pre></div></div>
          </details>`}
        ${group.length > 1 ? `<details class="affected-urls"><summary>Затронутые страницы (${group.length})</summary>${group.slice(0, 30).map((issue) => issue.url ? `<a href="${escapeHtml(issue.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(issue.url))}</a>` : '').join('')}</details>` : item.url ? `<a href="${escapeHtml(item.url)}" target="_blank" rel="noreferrer">${escapeHtml(shortUrl(item.url))}</a>` : ''}
      </div>
    </article>`;
  }

  function renderReport(report: AuditReport) {
    try { resolvedIssues = new Set(JSON.parse(localStorage.getItem(resolvedKey(report)) || '[]')); } catch { resolvedIssues = new Set(); }
    const previous = readHistory().find((item) => item.origin === report.origin && item.id !== report.id);
    saveHistory(report);
    renderHistory();
    renderComparison(report, previous);
    $('#report-url').textContent = report.url;
    $('#score-value').textContent = String(report.score);
    $('#score-grade').textContent = report.grade;
    $('#score-label').textContent = report.score >= 85 ? 'Сайт в хорошем состоянии' : report.score >= 65 ? 'Есть заметный потенциал' : report.score >= 45 ? 'Нужны системные исправления' : 'SEO требует срочного внимания';
    $('#score-summary').textContent = report.score >= 75 ? 'Основа настроена. Сосредоточьтесь на задачах с высоким приоритетом.' : 'Начните с индексации и критичных технических ошибок — они сильнее всего мешают росту.';
    const ring = $('#score-ring');
    ring.style.setProperty('--score', String(report.score));
    ring.dataset.tone = scoreTone(report.score);
    $('#pages-count').textContent = String(report.pagesScanned);
    $('#critical-count').textContent = String(report.totals.critical);
    $('#high-count').textContent = String(report.totals.high);
    $('#duration-value').textContent = (report.duration / 1000).toFixed(1);
    $('#issues-badge').textContent = String(report.totals.issues);
    $('#category-scores').innerHTML = Object.entries(report.categoryScores).map(([key, score]) => `<div class="category-row">
      <div><span>${escapeHtml(categoryLabels[key])}</span><strong>${score}</strong></div>
      <div class="score-track"><i class="${scoreTone(score)}" style="width:${score}%"></i></div>
    </div>`).join('');
    $('#priority-issues').innerHTML = report.issues.slice(0, 4).map((item) => issueMarkup(item, true)).join('') || '<p class="empty-state">Критичных проблем не найдено.</p>';
    const state = new URLSearchParams(window.location.search);
    severityFilter = state.get('severity') || 'all'; issueQuery = state.get('q') || ''; categoryFilter = state.get('category') || 'all'; hideResolved = state.get('resolved') === 'hide'; groupIssues = state.get('group') !== 'off';
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((item) => item.classList.toggle('active', item.dataset.filter === severityFilter));
    const search = $('#issue-search') as HTMLInputElement; if (search) search.value = issueQuery;
    const category = $('#category-filter') as HTMLSelectElement; if (category) category.value = categoryFilter;
    const hidden = $('#hide-resolved') as HTMLInputElement; if (hidden) hidden.checked = hideResolved;
    const grouped = $('#group-issues') as HTMLInputElement; if (grouped) grouped.checked = groupIssues;
    renderIssues();
    pageQuery = state.get('pageQ') || ''; pageStatusFilter = state.get('pageStatus') || 'all'; pageSort = state.get('pageSort') || 'issues';
    ($('#page-search') as HTMLInputElement).value = pageQuery; ($('#page-status-filter') as HTMLSelectElement).value = pageStatusFilter; ($('#page-sort') as HTMLSelectElement).value = pageSort;
    renderPages(report);
    renderContent(report);
    renderArchitecture(report);
    void renderProductTools(report, previous);
    const requestedTab = new URLSearchParams(window.location.search).get('tab');
    openTab(['overview','issues','content','pages','architecture','technical','tools'].includes(requestedTab || '') ? requestedTab! : 'overview', false);
    const tech: Array<[string, boolean | null, string]> = [
      ['HTTPS', report.technical.https, report.technical.https ? 'Подключение защищено' : 'Используется HTTP'],
      ['robots.txt', report.technical.robotsFound, `HTTP ${report.technical.robotsStatus || 'ERR'}`],
      ['sitemap.xml', report.technical.sitemapFound, `HTTP ${report.technical.sitemapStatus || 'ERR'}`],
      ['llms.txt', null, report.technical.llmsFound ? 'Файл найден; Google Search его не использует' : 'Необязательный файл; отсутствие не влияет на Google Search'],
      ['Обнаружено URL', report.crawl.discovered > 0, `${report.crawl.discovered} адресов, проверено ${report.crawl.crawled}`],
      ['URL в Sitemap', report.crawl.sitemapUrls > 0, report.crawl.sitemapUrls ? `${report.crawl.sitemapUrls} адресов` : 'Карта не содержит URL'],
      ['Битые внутренние ссылки', report.crawl.brokenInternal === 0, report.crawl.brokenInternal ? `Найдено: ${report.crawl.brokenInternal}` : 'Не найдено среди проверенных страниц'],
      ['Закрыто robots.txt', report.crawl.blockedByRobots === 0, report.crawl.blockedByRobots ? `Пропущено URL: ${report.crawl.blockedByRobots}` : 'Обход не ограничен'],
      ...Object.entries(report.technical.securityHeaders).map(([key, value]) => [key, value, value ? 'Заголовок настроен' : 'Заголовок не найден'] as [string, boolean, string]),
    ];
    $('#technical-grid').innerHTML = tech.map(([name, ok, detail]) => `<div class="tech-row"><span class="tech-icon ${ok === null ? 'info' : ok ? 'ok' : 'missing'}">${ok === null ? 'i' : ok ? '✓' : '—'}</span><div><strong>${escapeHtml(name)}</strong><p>${escapeHtml(detail)}</p></div><span>${ok === null ? 'Инфо' : ok ? 'OK' : 'Проверить'}</span></div>`).join('');
    ($('#robots-test-url') as HTMLInputElement).value = report.url;
    $('#robots-test-result').className = 'tester-result'; $('#robots-test-result').textContent = 'Выберите робота и проверьте URL.';
    $('#pagespeed-report').hidden = true; $('#pagespeed-report').innerHTML = '';
  }

  function saveHistory(report: AuditReport) {
    const next = [reportSummary(report), ...readHistory().filter((item) => item.id !== report.id)].slice(0, 10);
    localStorage.setItem(historyKey, JSON.stringify(next));
    saveFullReport(report).catch(() => { /* compact history remains available */ });
  }

  function renderHistory() {
    const history = readHistory();
    const panel = $('#history-panel');
    panel.hidden = history.length === 0;
    const visible = historyExpanded ? history : history.slice(0, 3);
    const toggle = $('#history-toggle') as HTMLButtonElement; toggle.hidden = history.length <= 3; toggle.textContent = historyExpanded ? 'Свернуть' : `Показать все (${history.length})`;
    $('#history-list').innerHTML = visible.map((item, index) => {
      const previous = history.slice(index + 1).find((candidate) => candidate.origin === item.origin);
      const delta = previous ? item.score - previous.score : null;
      return `<article><div class="history-score ${scoreTone(item.score)}">${item.score}</div><div><strong>${escapeHtml(new URL(item.url).hostname)}</strong><p>${formatDate(item.createdAt)} · ${item.pagesScanned} стр. · ${item.totals.issues} ошибок</p></div>${delta == null ? '<span class="history-delta">первый</span>' : `<span class="history-delta ${delta >= 0 ? 'up' : 'down'}">${delta >= 0 ? '+' : ''}${delta}</span>`}<div class="history-row-actions"><button type="button" data-open-report="${escapeHtml(item.id)}">Открыть</button><button type="button" data-rerun-url="${escapeHtml(item.url)}">↻ Повторить</button></div></article>`;
    }).join('');
  }

  function renderComparison(report: AuditReport, previous?: ReportSummary) {
    const panel = $('#comparison-strip');
    panel.hidden = !previous;
    if (!previous) return;
    $('#comparison-date').textContent = `предыдущий: ${formatDate(previous.createdAt)}`;
    const deltaMarkup = (value: number, inverse = false) => `<span class="delta-value ${(inverse ? value <= 0 : value >= 0) ? 'positive' : 'negative'}">${value > 0 ? '+' : ''}${value}</span>`;
    $('#compare-score').innerHTML = deltaMarkup(report.score - previous.score);
    $('#compare-issues').innerHTML = deltaMarkup(report.totals.issues - previous.totals.issues, true);
    $('#compare-critical').innerHTML = deltaMarkup(report.totals.critical - previous.totals.critical, true);
    $('#compare-pages').innerHTML = deltaMarkup(report.pagesScanned - previous.pagesScanned);
  }

  function renderContent(report: AuditReport) {
    const summary = report.contentSummary;
    const dimensionLabels: Record<keyof ContentAnalysis['dimensions'], string> = { intent: 'Интент', depth: 'Полнота', structure: 'Структура', readability: 'Читаемость', originality: 'Уникальность', experience: 'Опыт', expertise: 'Экспертность', trust: 'Доверие', keywordUse: 'Ключевые фразы', aiReadiness: 'AI-цитирование' };
    const dimensions = summary.averageDimensions || Object.fromEntries((Object.keys(dimensionLabels) as Array<keyof ContentAnalysis['dimensions']>).map((key) => [key, Math.round(report.pages.reduce((sum, page) => sum + contentFor(page).dimensions[key], 0) / Math.max(1, report.pages.length))])) as ContentAnalysis['dimensions'];
    $('#content-kpis').innerHTML = [
      ['Качество контента', summary.averageContentScore, 'средняя оценка'],
      ['Читабельность', summary.averageReadability, 'эвристика 0–100'],
      ['AI-цитируемость', summary.averageAiCitationScore, 'структура и доказательства'],
      ['Тонкие страницы', summary.thinPages, `из ${report.pagesScanned}`],
    ].map(([label, value, detail]) => `<div><span>${escapeHtml(label)}</span><strong class="${typeof value === 'number' && label !== 'Тонкие страницы' ? scoreTone(value) : ''}">${value}</strong><small>${escapeHtml(detail)}</small></div>`).join('');

